{
  "magic": "ALCART1",
  "name": "ferry",
  "code": "# Паром Тота. Стрелки или WASD — ход, Esc — назад в редактор.\n# Цвет 0 на спрайте прозрачный. pal(511, ...) железо отбросит.\n\npx = 148\npy = 118\nscore = 0\ngx = 0\ngy = 0\nalive = 0\n\ndef _init():\n    global gx, gy, alive\n    # Палитра кассеты уже залита в AMATERASU. Это — живая запись слота.\n    pal(6, 31, 22, 8)\n    gx = [36, 96, 160, 220, 280]\n    gy = [48, 96, 64, 140, 168]\n    alive = [1, 1, 1, 1, 1]\n    music(0)\n\ndef _update():\n    global px, py, score\n    if btn(0):\n        px = px - 2\n    if btn(1):\n        px = px + 2\n    if btn(2):\n        py = py - 2\n    if btn(3):\n        py = py + 2\n    if px < 4:\n        px = 4\n    if px > 300:\n        px = 300\n    if py < 32:\n        py = 32\n    if py > 210:\n        py = 210\n    i = 0\n    while i < 5:\n        if alive[i] == 1:\n            dx = px + 8 - gx[i]\n            dy = py + 8 - gy[i]\n            if dx < 0:\n                dx = 0 - dx\n            if dy < 0:\n                dy = 0 - dy\n            if dx < 14:\n                if dy < 14:\n                    alive[i] = 0\n                    score = score + 1\n                    sfx(0)\n        i = i + 1\n    left = 0\n    i = 0\n    while i < 5:\n        if alive[i] == 1:\n            left = left + 1\n        i = i + 1\n    if left == 0:\n        alive[0] = 1\n        alive[1] = 1\n        alive[2] = 1\n        alive[3] = 1\n        alive[4] = 1\n        gx[0] = 24 + rnd(250)\n        gx[1] = 24 + rnd(250)\n        gx[2] = 24 + rnd(250)\n        gx[3] = 24 + rnd(250)\n        gx[4] = 24 + rnd(250)\n        gy[0] = 40 + rnd(140)\n        gy[1] = 40 + rnd(140)\n        gy[2] = 40 + rnd(140)\n        gy[3] = 40 + rnd(140)\n        gy[4] = 40 + rnd(140)\n\ndef _draw():\n    cls(4)\n    y = frame() % 16\n    while y < 240:\n        rectfill(0, y, 320, 1, 5)\n        y = y + 16\n    rectfill(0, 0, 320, 26, 0)\n    rectfill(0, 26, 320, 1, 1)\n    text(\"FERRY OF THOTH\", 8, 6, 1)\n    text(score, 168, 6, 6)\n    text(cycles(), 220, 6, 3)\n    spr(33, 8, 200)\n    spr(33, 300, 78)\n    i = 0\n    while i < 5:\n        if alive[i] == 1:\n            spr(32, gx[i], gy[i])\n        i = i + 1\n    spr(1, px, py, 2, 2)\n    if score >= 5:\n        text(\"THE RIVER REMEMBERS\", 64, 214, 3)\n",
